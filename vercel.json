{
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "framework": null,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/api/google-places/(.*)",
      "dest": "https://places.googleapis.com/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
